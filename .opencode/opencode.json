{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "godot": {
        "type": "local",
        "command": ["npx", "-y", "@satelliteoflove/godot-mcp@4.1.11"]
      },
      "godot-ai": {
        "type": "local",
        "command": [
          "uvx",
          "--isolated",
          "--no-config",
          "--no-env-file",
          "--no-sources",
          "--no-build",
          "--index-strategy", "first-index",
          "--keyring-provider", "disabled",
          "--index", "https://pypi.org/simple",
          "--default-index", "https://pypi.org/simple",
          "--find-links", "https://pypi.org/simple/godot-ai/",
          "--link-mode", "copy",
          "--from", "godot-ai==4.3.0",
          "godot-ai",
          "attach",
          "--port", "8000",
          "--ws-port", "9500",
          "--disable-telemetry"
        ],
        "enabled": true
      }
    }
  }
}
