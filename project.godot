; Engine configuration file.
; Proyecto: Baracoa — Mundo Abierto Pixelado Online
; Fase 0 (FOUNDATION). Ver docs/architecture/ARCHITECTURE.md

config_version=5

[application]

config/name="Baracoa Mundo Abierto"
config/description="Mundo abierto pixel-art top-down, multijugador server-authoritative."
run/main_scene="res://scenes/world/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Game="*res://scenes/shared/game.tscn"

[display]

